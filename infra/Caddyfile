ichangehub.me {
  root * /opt/ichange/apps/frontend/dist
  encode gzip zstd
  
  @static {
    path *.js *.css *.png *.jpg *.ico *.woff2 *.svg
  }
  header @static Cache-Control "public, max-age=31536000, immutable"
  header Cache-Control "no-cache, must-revalidate"

  try_files {path} /index.html
  file_server
}
