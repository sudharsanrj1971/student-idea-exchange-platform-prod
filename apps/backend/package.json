{
  "name": "@ichange/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "predev": "npx kill-port 5010",
    "dev": "nodemon src/index.js",
    "prestart": "npx kill-port 5000",
    "start": "node src/index.js",
    "start:scale": "cross-env UV_THREADPOOL_SIZE=128 node --max-old-space-size=8192 src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^5.1.1",
    "mediasoup": "^3.14.14",
    "mongo-sanitize": "^1.1.0",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^8.4.1",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "autocannon": "^8.0.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      "dist",
      "scripts",
      "*.csv",
      "logs"
    ]
  }
}
