# IChange Production Environment Template
# Copy this to .env and fill in all values before starting the server

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB - MUST be a persistent cluster (e.g. Self-hosted Docker or Atlas)
# Format: mongodb://user:password@localhost:27017/ichange  (self-hosted)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>  (Atlas)
MONGODB_URI=

# JWT Secrets - Use long, random strings (min 64 chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis - MANDATORY for production clustering
# Self-hosted Docker: redis://localhost:6379
# SSL: rediss://<host>:<port>
REDIS_URL=redis://localhost:6379

# Admin Account Credentials (used to auto-create the admin user on first start)
# IMPORTANT: Set a strong password here. Never hardcode in source code.
ADMIN_EMAIL=sudharsanrj1971@gmail.com
ADMIN_PASSWORD=

# Mediasoup Configuration
# CRITICAL: Set this to the PUBLIC IP of your Oracle Cloud server.
# If this is wrong, WebRTC video/audio will NOT work for remote users.
MEDIASOUP_ANNOUNCED_IP=
# IP to listen on (always 0.0.0.0 for Docker/server)
MEDIASOUP_LISTEN_IP=0.0.0.0
# UDP Port range for media traffic (Ensure these are open in Oracle Cloud firewall)
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=59999

# Frontend URL for CORS (e.g. https://ichange.pages.dev or your custom domain)
FRONTEND_URL=https://your-app-domain.com

# Analytics / Monitoring (Optional)
# LOG_LEVEL=info

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=
